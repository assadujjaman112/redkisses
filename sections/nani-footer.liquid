{% liquid
  assign s = section.settings
%}

{%- comment -%}
  No `.section-background` element here on purpose. Horizon only contains that
  element by giving the `.shopify-section` wrapper `position: relative`, and its
  rule for that (`.shopify-section:has(.section)`) requires a `.section` element
  inside the section. This footer renders `.nani-footer` instead, so the
  background div had no positioned ancestor: it sized itself against the initial
  containing block and painted the scheme's near-black over the whole first
  viewport of every page, at `z-index: -2`. It was invisible on pages whose
  sections paint their own opaque backgrounds, but showed through on any page
  built from Horizon `.section` elements (base.css forces those transparent) —
  the cart page most visibly. `.nani-footer` already carries the color scheme
  class, so it paints its own background and the extra element was redundant.
{%- endcomment -%}
<footer class="nani-footer color-{{ s.color_scheme }}">
  <div class="nani-footer__inner">

    <div class="nani-footer__top">
      <div class="nani-footer__brand">
        {% if settings.logo != blank %}
          <a href="{{ routes.root_url }}" class="nani-footer__logo-link" aria-label="{{ shop.name }}">
            {{ settings.logo | image_url: width: 280 | image_tag:
              class: 'nani-footer__logo',
              widths: '140, 200, 280, 400',
              sizes: '140px',
              loading: 'lazy',
              alt: shop.name }}
          </a>
        {% else %}
          <div class="nani-footer__wordmark">{{ shop.name }}</div>
        {% endif %}

        {% if s.tagline != blank %}
          <p class="nani-footer__tagline">{{ s.tagline }}</p>
        {% endif %}

        <div class="nani-footer__social">
          {% if s.instagram_url != blank %}
            <a href="{{ s.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
            </a>
          {% endif %}
          {% if s.tiktok_url != blank %}
            <a href="{{ s.tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 3c.5 2.5 2 4 4.5 4.2V10c-1.7 0-3.3-.4-4.5-1.2V16a5.5 5.5 0 1 1-5.5-5.5v2.7a2.8 2.8 0 1 0 2.8 2.8V3H16z"/></svg>
            </a>
          {% endif %}
          {% if s.youtube_url != blank %}
            <a href="{{ s.youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 7.5a3 3 0 0 0-2.1-2.1C18 5 12 5 12 5s-6 0-7.9.4A3 3 0 0 0 2 7.5C1.6 9.4 1.6 12 1.6 12s0 2.6.4 4.5a3 3 0 0 0 2.1 2.1C6 19 12 19 12 19s6 0 7.9-.4a3 3 0 0 0 2.1-2.1c.4-1.9.4-4.5.4-4.5s0-2.6-.4-4.5zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
            </a>
          {% endif %}
          {% if s.pinterest_url != blank %}
            <a href="{{ s.pinterest_url }}" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2.1 0-3l1.3-5.5s-.3-.6-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.6-.2 1 .5 1.9 1.6 1.9 1.9 0 3.3-2 3.3-4.9 0-2.6-1.8-4.4-4.5-4.4-3 0-4.8 2.3-4.8 4.6 0 .9.3 1.9.8 2.4.1.1.1.2.1.3l-.3 1.2c0 .2-.1.2-.3.1-1.3-.6-2-2.4-2-3.9 0-3.2 2.3-6.1 6.7-6.1 3.5 0 6.3 2.5 6.3 5.9 0 3.5-2.2 6.3-5.2 6.3-1 0-2-.5-2.3-1.2l-.6 2.4c-.2.9-.8 2-1.2 2.7a10 10 0 1 0 2.5-19.5z"/></svg>
            </a>
          {% endif %}
          {% if s.snapchat_url != blank %}
            <a href="{{ s.snapchat_url }}" aria-label="Snapchat" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c3.3 0 5 2.4 5 5.5 0 1.5-.3 3.6-.3 3.6s.8 0 1.5.4c.4.2.3.7-.1 1-.8.7-2 .9-2 1.5 0 .7 1.5 2.1 3.1 2.5.4.1.5.5.3.8-.5.7-1.6 1-2.7 1.2-.2.5-.1 1.3-.7 1.4-.5.1-1.3-.2-2.4-.2-1.6 0-2.3 1.3-4 1.3s-2.4-1.3-4-1.3c-1.1 0-1.9.3-2.4.2-.6-.1-.5-.9-.7-1.4-1.1-.2-2.2-.5-2.7-1.2-.2-.3-.1-.7.3-.8 1.6-.4 3.1-1.8 3.1-2.5 0-.6-1.2-.8-2-1.5-.4-.3-.5-.8-.1-1 .7-.4 1.5-.4 1.5-.4s-.3-2.1-.3-3.6C7 4.4 8.7 2 12 2z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'link_column' %}
          {% liquid
            assign b = block.settings
            assign menu = linklists[b.menu]
          %}
          <div class="nani-footer__col" {{ block.shopify_attributes }}>
            <h5 class="nani-footer__col-title">{{ b.title }}</h5>
            <ul class="nani-footer__col-list">
              {% if menu.links.size > 0 %}
                {% for link in menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              {% else %}
                <li><a href="#">Edit this column in the theme editor</a></li>
              {% endif %}
            </ul>
          </div>
        {% endif %}

        {% if block.type == 'contact_column' %}
          {% liquid assign b = block.settings %}
          <div class="nani-footer__col" {{ block.shopify_attributes }}>
            <h5 class="nani-footer__col-title">{{ b.title }}</h5>
            <ul class="nani-footer__col-list">
              {% if b.email != blank %}
                <li><a href="mailto:{{ b.email }}">{{ b.email }}</a></li>
              {% endif %}
              {% if b.phone != blank %}
                <li><a href="tel:{{ b.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ b.phone }}</a></li>
              {% endif %}
              {% if b.address != blank %}
                <li>{{ b.address }}</li>
              {% endif %}
              {% if b.hours != blank %}
                <li>{{ b.hours }}</li>
              {% endif %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="nani-footer__bottom">
      <div class="nani-footer__copyright">
        © {{ 'now' | date: '%Y' }} {{ s.copyright_name | default: shop.name }}{% if s.copyright_suffix %} · {{ s.copyright_suffix }}{% endif %}
      </div>

      {% if s.show_payments %}
        <div class="nani-footer__pay">
          {% assign pays = s.payments | split: ',' %}
          {% for p in pays %}
            <span class="nani-footer__pay-chip">{{ p | strip }}</span>
          {% endfor %}
        </div>
      {% endif %}

      {% if shop.privacy_policy or shop.terms_of_service or shop.refund_policy %}
        <div class="nani-footer__legal">
          {% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}
          {% if shop.terms_of_service %} · <a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}
          {% if shop.refund_policy %} · <a href="{{ shop.refund_policy.url }}">Refund</a>{% endif %}
        </div>
      {% endif %}
    </div>

  </div>
</footer>

{% stylesheet %}
  .nani-footer {
    position: relative;
  }

  .nani-footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 80px 40px 0;
  }

  .nani-footer__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: 60px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .nani-footer__brand {
    display: flex;
    flex-direction: column;
  }

  .nani-footer__logo {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .nani-footer__wordmark {
    font-family: var(--font-heading--family);
    font-size: 34px;
    font-weight: 500;
    color: var(--color-foreground-heading);
  }

  .nani-footer__tagline {
    max-width: 300px;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    margin: 20px 0 24px;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.55;
  }

  .nani-footer__social {
    display: flex;
    gap: 10px;
  }

  .nani-footer__social a {
    width: 38px;
    height: 38px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nani-footer__social a:hover {
    background: #C9A227;
    border-color: #C9A227;
    color: #0D0A0B;
  }

  .nani-footer__social svg {
    width: 16px;
    height: 16px;
  }

  .nani-footer__col-title {
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #C9A227;
    margin: 0 0 22px;
  }

  .nani-footer__col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nani-footer__col-list a,
  .nani-footer__col-list li {
    font-family: var(--font-body--family);
    font-size: 13.5px;
    color: rgb(var(--color-foreground-rgb) / 0.75);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nani-footer__col-list a:hover {
    color: #C9A227;
  }

  .nani-footer__bottom {
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-body--family);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  .nani-footer__pay {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .nani-footer__pay-chip {
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    padding: 4px 8px;
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .nani-footer__legal a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nani-footer__legal a:hover {
    color: #C9A227;
  }

  @media screen and (max-width: 1100px) {
    .nani-footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .nani-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 560px) {
    .nani-footer__inner {
      padding: 60px 24px 0;
    }
    .nani-footer__top {
      grid-template-columns: 1fr;
      padding-bottom: 40px;
    }
    .nani-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand block"
    },
    {
      "type": "paragraph",
      "content": "Logo is set from Theme Settings → Logo. Falls back to shop name if not set."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Jewelry, lip gloss and shades for the everyday woman and girl. Made with love in Akron, Ohio, shipped nationwide."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "snapchat_url",
      "label": "Snapchat URL"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "Redkisses"
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright suffix",
      "default": "All rights reserved"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show payment method chips",
      "default": true
    },
    {
      "type": "text",
      "id": "payments",
      "label": "Payment methods (comma-separated)",
      "default": "Visa, Mastercard, Amex, Shop Pay, Apple Pay, PayPal"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact_column",
      "name": "Contact column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column title",
          "default": "Contact"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "sunsarae37@gmail.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "(330) 689-8922"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address",
          "default": "Akron, OH"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Hours",
          "default": "Mon–Sat · 9am–5pm ET"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_column", "settings": { "title": "Shop" } },
        { "type": "link_column", "settings": { "title": "Support" } },
        { "type": "link_column", "settings": { "title": "Brand" } },
        { "type": "contact_column" }
      ]
    }
  ]
}
{% endschema %}
