{% liquid
  assign s = section.settings
%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section class="bundle-feat color-{{ s.color_scheme }}">
  <div class="bundle-feat__inner">

    <div class="bundle-feat__visual">
      {% if s.image != blank %}
        {{ s.image | image_url: width: 1200 | image_tag:
          class: 'bundle-feat__image',
          widths: '480, 720, 960, 1200',
          sizes: '(min-width: 1100px) 46vw, 100vw',
          loading: 'lazy',
          alt: s.image_alt | default: s.headline }}
      {% elsif s.image_url != blank %}
        <img
          class="bundle-feat__image"
          src="{{ s.image_url }}"
          alt="{{ s.image_alt | default: s.headline }}"
          loading="lazy"
          decoding="async"
          width="1000"
          height="1200"
        >
      {% else %}
        <div class="bundle-feat__placeholder" aria-hidden="true">
          <span class="bundle-feat__placeholder-tag">[ drop-in gift set flat-lay · 1000×1200 ]</span>
        </div>
      {% endif %}

      {% if s.show_seal and s.seal_text != blank %}
        <div class="bundle-feat__seal">{{ s.seal_text }}</div>
      {% endif %}
    </div>

    <div class="bundle-feat__copy">
      {% if s.eyebrow != blank %}
        <div class="bundle-feat__eyebrow">{{ s.eyebrow }}</div>
      {% endif %}

      {% if s.headline != blank %}
        <h2 class="bundle-feat__title">{{ s.headline }}</h2>
      {% endif %}

      {% if s.description != blank %}
        <p class="bundle-feat__desc">{{ s.description }}</p>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <ul class="bundle-feat__list">
          {% for block in section.blocks %}
            <li class="bundle-feat__list-item" {{ block.shopify_attributes }}>
              <span class="bundle-feat__check" aria-hidden="true">✓</span>
              <span>{{ block.settings.text }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if s.price != blank %}
        <div class="bundle-feat__price">
          <span class="bundle-feat__price-big">{{ s.price }}</span>
          {% if s.compare_price != blank %}
            <span class="bundle-feat__price-strike">{{ s.compare_price }}</span>
          {% endif %}
          {% if s.save_text != blank %}
            <span class="bundle-feat__price-save">{{ s.save_text }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if s.primary_cta_label != blank or s.secondary_cta_label != blank %}
        <div class="bundle-feat__ctas">
          {% if s.primary_cta_label != blank %}
            <a class="bundle-feat__btn bundle-feat__btn--gold" href="{{ s.primary_cta_link | default: '#' }}">
              <span>{{ s.primary_cta_label }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {% endif %}
          {% if s.secondary_cta_label != blank %}
            <a class="bundle-feat__btn bundle-feat__btn--ghost" href="{{ s.secondary_cta_link | default: '#' }}">
              {{ s.secondary_cta_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% stylesheet %}
  .bundle-feat {
    position: relative;
    overflow: hidden;
  }

  .bundle-feat__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    min-height: 620px;
  }

  .bundle-feat__visual {
    position: relative;
    overflow: hidden;
    min-height: 420px;
  }

  .bundle-feat__image,
  .bundle-feat__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: flex;
    align-items: flex-end;
    padding: 32px;
  }

  .bundle-feat__placeholder {
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.08) 0 2px, transparent 2px 18px),
      linear-gradient(160deg, #C8102E 0%, #E0455F 70%, #EFB7BE 110%);
  }

  .bundle-feat__placeholder-tag {
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: rgb(26 18 8 / 0.55);
    color: #FBF8F6;
    padding: 8px 12px;
    border: 1px solid rgb(255 255 255 / 0.35);
  }

  .bundle-feat__seal {
    position: absolute;
    top: 40px;
    left: 40px;
    border: 1px solid #C9A227;
    color: #C9A227;
    padding: 10px 16px;
    font-family: var(--font-body--family);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    background: rgb(26 18 8 / 0.5);
    z-index: 2;
  }

  .bundle-feat__copy {
    padding: 90px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .bundle-feat__eyebrow {
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 24px;
  }

  .bundle-feat__title {
    font-family: var(--font-heading--family);
    font-size: clamp(38px, 4.5vw, 64px);
    line-height: 0.98;
    margin: 0 0 28px;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--color-foreground-heading);
  }

  .bundle-feat__title em {
    font-style: italic;
    color: var(--color-primary);
  }

  .bundle-feat__desc {
    font-family: var(--font-body--family);
    font-size: 15px;
    max-width: 500px;
    color: var(--color-foreground);
    opacity: 0.85;
    margin: 0 0 32px;
    line-height: 1.55;
  }

  .bundle-feat__list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 28px;
    max-width: 540px;
  }

  .bundle-feat__list-item {
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-body--family);
    font-size: 13px;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
  }

  .bundle-feat__check {
    width: 20px;
    height: 20px;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .bundle-feat__price {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .bundle-feat__price-big {
    font-family: var(--font-heading--family);
    font-size: clamp(40px, 4vw, 58px);
    color: var(--color-primary);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 500;
  }

  .bundle-feat__price-strike {
    color: rgb(var(--color-foreground-rgb) / 0.5);
    text-decoration: line-through;
    font-size: 18px;
    font-family: var(--font-body--family);
  }

  .bundle-feat__price-save {
    background: #C8102E;
    color: #FBF8F6;
    padding: 4px 10px;
    font-family: var(--font-body--family);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .bundle-feat__ctas {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .bundle-feat__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border-radius: 2px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .bundle-feat__btn--gold {
    background: #C9A227;
    color: #0D0A0B;
    border: 1px solid #C9A227;
  }

  .bundle-feat__btn--gold:hover {
    background: #F0E3B8;
    border-color: #F0E3B8;
  }

  .bundle-feat__btn--ghost {
    background: transparent;
    color: var(--color-foreground-heading);
    border: 1px solid var(--color-foreground-heading);
  }

  .bundle-feat__btn--ghost:hover {
    background: var(--color-foreground-heading);
    color: var(--color-background);
  }

  @media screen and (max-width: 1100px) {
    .bundle-feat__inner {
      grid-template-columns: 1fr;
    }
    .bundle-feat__copy {
      padding: 56px 40px;
    }
    .bundle-feat__visual {
      min-height: 480px;
    }
  }

  @media screen and (max-width: 749px) {
    .bundle-feat__copy {
      padding: 48px 24px;
    }
    .bundle-feat__list {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .bundle-feat__seal {
      top: 20px;
      left: 20px;
      font-size: 10px;
      padding: 8px 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle feature",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Kiss Kit"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap words in <em>italic</em> for accent color",
      "default": "Three glosses. One <em>gift box.</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hot Pink, Ruby Red and Nude Kiss — our three signature high-shine glosses in one black Redkisses gift box. One checkout, one box, all shine."
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$30"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare-at price (strikethrough)",
      "default": "$36"
    },
    {
      "type": "text",
      "id": "save_text",
      "label": "Save badge text",
      "default": "Save 17%"
    },
    {
      "type": "header",
      "content": "Call-to-action buttons"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button",
      "default": "Add to bag"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button",
      "default": "See what's inside"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (fallback)",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "The Kiss Kit gift box flat-lay"
    },
    {
      "type": "header",
      "content": "Seal badge (top-left of image)"
    },
    {
      "type": "checkbox",
      "id": "show_seal",
      "label": "Show seal",
      "default": true
    },
    {
      "type": "text",
      "id": "seal_text",
      "label": "Seal text",
      "default": "★ Best Seller · Ships in 1–2 days"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "blocks": [
    {
      "type": "list_item",
      "name": "Checklist item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item text",
          "default": "3× Signature Lip Gloss"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Bundle feature",
      "category": "Redkisses",
      "blocks": [
        { "type": "list_item", "settings": { "text": "3× Signature Lip Gloss" } },
        { "type": "list_item", "settings": { "text": "Hot Pink · Ruby Red · Nude Kiss" } },
        { "type": "list_item", "settings": { "text": "High-shine, non-sticky formula" } },
        { "type": "list_item", "settings": { "text": "Gold crystal cap, black gift box" } },
        { "type": "list_item", "settings": { "text": "Free shipping included" } },
        { "type": "list_item", "settings": { "text": "Handwritten thank-you card" } }
      ]
    }
  ]
}
{% endschema %}
