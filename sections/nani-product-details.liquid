{% liquid
  assign s = section.settings
  assign spec_pairs = s.spec_rows | newline_to_br | split: '<br />'
%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section class="nani-pdet color-{{ s.color_scheme }}"
  style="--pbs: {{ s.padding-block-start }}px; --pbe: {{ s.padding-block-end }}px;"
>
  <div class="nani-pdet__inner">
    <div class="nani-pdet__copy">
      {% if s.eyebrow != blank %}
        <div class="nani-pdet__eyebrow">{{ s.eyebrow }}</div>
      {% endif %}
      {% if s.headline != blank %}
        <h2 class="nani-pdet__title">{{ s.headline }}</h2>
      {% endif %}
      {% if s.body != blank %}
        <div class="nani-pdet__body">{{ s.body }}</div>
      {% endif %}
    </div>
    <div class="nani-pdet__spec">
      {% for pair in spec_pairs %}
        {% liquid
          assign parts = pair | split: '|'
          assign label = parts[0] | strip
          assign value = parts[1] | strip
        %}
        {% if label != blank %}
          <div class="nani-pdet__spec-label">{{ label }}</div>
          <div class="nani-pdet__spec-value">{{ value }}</div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .nani-pdet {
    position: relative;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }
  .nani-pdet__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--pbs) 40px var(--pbe) 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }
  .nani-pdet__eyebrow {
    font-family: var(--font-body--family);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
    font-weight: 500;
  }
  .nani-pdet__title {
    font-family: var(--font-heading--family);
    font-size: clamp(34px, 3.6vw, 46px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin: 0 0 20px;
    color: var(--color-foreground-heading);
  }
  .nani-pdet__title em { font-style: italic; color: var(--color-primary); }
  .nani-pdet__body {
    font-family: var(--font-body--family);
    color: var(--color-foreground);
    opacity: 0.9;
    line-height: 1.7;
  }
  .nani-pdet__body p { margin: 0 0 14px; }

  .nani-pdet__spec {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    align-self: start;
  }
  .nani-pdet__spec-label,
  .nani-pdet__spec-value {
    padding: 14px 18px;
    font-family: var(--font-body--family);
    font-size: 13.5px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }
  .nani-pdet__spec-label {
    background: var(--color-background);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11px;
    color: var(--color-foreground);
    border-right: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }
  .nani-pdet__spec-value {
    color: var(--color-foreground-heading);
  }
  .nani-pdet__spec > :nth-last-child(-n+2) { border-bottom: 0; }

  @media screen and (max-width: 1100px) {
    .nani-pdet__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-left: 24px;
      padding-right: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it's different"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Real shine, <em>really.</em>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Most lip gloss on the market is either sticky or sheer. Ours isn't. Every gloss is high-shine, buildable, and non-sticky — so it lasts through a full day without touch-ups.</p><p>Every batch is personally checked before it hits the shop. If it doesn't pass the shine test, it doesn't get listed.</p>"
    },
    {
      "type": "textarea",
      "id": "spec_rows",
      "label": "Spec rows (one per line, Label | Value)",
      "default": "Formula | High-shine, non-sticky\nSize | 0.34 fl oz\nFinish | Glossy\nShade | Ruby Red (customizable)\nScent | Light vanilla\nApplicator | Doe-foot wand\nCruelty-free | Yes\nPacked in | Black Redkisses gift box"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "category": "Redkisses"
    }
  ]
}
{% endschema %}
