{% liquid
  assign s = section.settings
%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section class="reviews-sect color-{{ s.color_scheme }}"
  style="--rev-padding-block-start: {{ s.padding-block-start }}px; --rev-padding-block-end: {{ s.padding-block-end }}px;"
>
  <div class="reviews-sect__inner">
    <header class="reviews-sect__head">
      {% if s.eyebrow != blank %}
        <div class="reviews-sect__eyebrow">{{ s.eyebrow }}</div>
      {% endif %}
      {% if s.title != blank %}
        <h2 class="reviews-sect__title">{{ s.title }}</h2>
      {% endif %}
    </header>

    <div class="reviews-sect__grid">
      {% for block in section.blocks %}
        {% liquid
          assign b = block.settings
          assign initials = b.reviewer_name | split: ' ' | map: 'first' | join: '' | upcase | slice: 0, 2
        %}
        <article class="review" {{ block.shopify_attributes }}>
          <div class="review__stars" aria-label="{{ b.stars }} out of 5">{{ b.stars }}</div>
          <blockquote class="review__quote">{{ b.quote }}</blockquote>
          <div class="review__foot">
            <div class="review__ava" aria-hidden="true">{{ initials | default: '★' }}</div>
            <div class="review__meta">
              <span class="review__name">{{ b.reviewer_name }}</span>
              <span class="review__prod">{{ b.product_name }}</span>
            </div>
            {% if b.verified %}
              <span class="review__verified">✓ Verified</span>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .reviews-sect {
    position: relative;
  }

  .reviews-sect__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--rev-padding-block-start) 40px var(--rev-padding-block-end) 40px;
  }

  .reviews-sect__head {
    text-align: center;
    margin-bottom: 48px;
  }

  .reviews-sect__eyebrow {
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C9A227;
    margin-bottom: 14px;
  }

  .reviews-sect__title {
    font-family: var(--font-heading--family);
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
    color: var(--color-foreground-heading);
  }

  .reviews-sect__title em {
    font-style: italic;
    color: var(--color-primary);
  }

  .reviews-sect__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .review {
    background: #FBF8F6;
    border: 1px solid rgb(26 18 8 / 0.06);
    padding: 32px 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: #0D0A0B;
  }

  .review__stars {
    color: #C9A227;
    letter-spacing: 0.08em;
    font-size: 14px;
  }

  .review__quote {
    font-family: var(--font-heading--family);
    font-size: 22px;
    line-height: 1.3;
    margin: 0;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .review__quote::before {
    content: "\201C";
    color: #C8102E;
    font-size: 40px;
    line-height: 0;
    position: relative;
    top: 12px;
    margin-right: 4px;
  }

  .review__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid rgb(26 18 8 / 0.06);
  }

  .review__ava {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #EFB7BE, #E0455F);
    color: #FBF8F6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .review__meta {
    display: flex;
    flex-direction: column;
  }

  .review__name {
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
  }

  .review__prod {
    font-family: var(--font-body--family);
    font-size: 11px;
    color: rgb(26 18 8 / 0.55);
    letter-spacing: 0.08em;
  }

  .review__verified {
    margin-left: auto;
    font-family: var(--font-body--family);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C8102E;
  }

  @media screen and (max-width: 1100px) {
    .reviews-sect__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .reviews-sect__inner {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "★★★★★ · 4.9 from 300+ reviews"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "What <em>Redkisses</em> customers say."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Stars",
          "default": "★★★★★"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The Kiss Kit literally saved my gift shopping. Three glosses, one box — showed up two days after I ordered. No notes."
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "Brianna K."
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product / context",
          "default": "The Kiss Kit"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Reviews",
      "category": "Redkisses",
      "blocks": [
        { "type": "review", "settings": { "stars": "★★★★★", "quote": "The Kiss Kit literally saved my gift shopping. Three glosses, one box — showed up two days after I ordered. No notes.", "reviewer_name": "Brianna K.", "product_name": "The Kiss Kit" } },
        { "type": "review", "settings": { "stars": "★★★★★", "quote": "Been buying my lip gloss from Redkisses for six months. Better pigment than the mall brands at half the price.", "reviewer_name": "Jasmine T.", "product_name": "Signature Lip Gloss" } },
        { "type": "review", "settings": { "stars": "★★★★★", "quote": "They DM'd me back in ten minutes about a shade match. Who does that anymore? Customer for life.", "reviewer_name": "Alexis R.", "product_name": "Icy Anklet" } }
      ]
    }
  ]
}
{% endschema %}
