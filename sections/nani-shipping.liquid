{% liquid
  assign s = section.settings
%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section class="nani-doc color-{{ s.color_scheme }}"
  style="--pbs: {{ s.padding-block-start }}px; --pbe: {{ s.padding-block-end }}px;"
>
  {% if s.show_crumb %}
    <nav class="nani-doc__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep">/</span>
      <span class="here">{{ s.crumb_label | default: 'Shipping & Returns' }}</span>
    </nav>
  {% endif %}

  <div class="nani-doc__layout">
    {%- comment -%} STICKY TOC {%- endcomment -%}
    <aside class="nani-doc__toc">
      <h5>On this page</h5>
      <div class="nani-doc__toc-links">
        {% for block in section.blocks %}
          {% if block.settings.toc_title != blank %}
            {% assign anchor = block.settings.toc_title | handleize %}
            <a href="#{{ anchor }}" data-toc="{{ anchor }}">{{ block.settings.toc_title }}</a>
          {% endif %}
        {% endfor %}
      </div>

      {% if s.show_help_card %}
        <div class="nani-doc__help">
          <h6>{{ s.help_title | default: 'Need a human?' }}</h6>
          <p>{{ s.help_copy | default: 'Usually on IG within the hour — fastest way to get unstuck.' }}</p>
          <a href="{{ s.help_url | default: '#' }}">{{ s.help_cta | default: 'Contact us →' }}</a>
        </div>
      {% endif %}
    </aside>

    <main class="nani-doc__body">
      {% if s.meta != blank %}
        <div class="nani-doc__meta-eyebrow">{{ s.meta }}</div>
      {% endif %}
      {% if s.title != blank %}
        <h1 class="nani-doc__title">{{ s.title }}</h1>
      {% endif %}
      {% if s.intro != blank %}
        <p class="nani-doc__intro">{{ s.intro }}</p>
      {% endif %}

      {% if s.tldr_1_value != blank or s.tldr_2_value != blank or s.tldr_3_value != blank %}
        <div class="nani-doc__tldr">
          {% if s.tldr_1_value != blank %}
            <div class="nani-doc__tldr-item">
              <div class="nani-doc__tldr-l">{{ s.tldr_1_label }}</div>
              <div class="nani-doc__tldr-v">{{ s.tldr_1_value }}</div>
              <div class="nani-doc__tldr-s">{{ s.tldr_1_sub }}</div>
            </div>
          {% endif %}
          {% if s.tldr_2_value != blank %}
            <div class="nani-doc__tldr-item">
              <div class="nani-doc__tldr-l">{{ s.tldr_2_label }}</div>
              <div class="nani-doc__tldr-v">{{ s.tldr_2_value }}</div>
              <div class="nani-doc__tldr-s">{{ s.tldr_2_sub }}</div>
            </div>
          {% endif %}
          {% if s.tldr_3_value != blank %}
            <div class="nani-doc__tldr-item">
              <div class="nani-doc__tldr-l">{{ s.tldr_3_label }}</div>
              <div class="nani-doc__tldr-v">{{ s.tldr_3_value }}</div>
              <div class="nani-doc__tldr-s">{{ s.tldr_3_sub }}</div>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% for block in section.blocks %}
        {% liquid
          assign b = block.settings
          assign anchor = b.toc_title | handleize
        %}
        <section class="nani-doc__section" id="{{ anchor }}" {{ block.shopify_attributes }}>
          {% if b.eyebrow != blank %}
            <div class="nani-doc__section-eyebrow">{{ b.eyebrow }}</div>
          {% endif %}
          {% if b.title != blank %}
            <h2 class="nani-doc__section-title">{{ b.title }}</h2>
          {% endif %}

          {% case block.type %}

            {% when 'text' %}
              {% if b.body != blank %}<div class="nani-doc__text">{{ b.body }}</div>{% endif %}
              {% if b.list != blank %}
                {% assign items = b.list | newline_to_br | split: '<br />' %}
                <ul class="nani-doc__list">
                  {% for item in items %}
                    {% if item != blank %}<li>{{ item | strip }}</li>{% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
              {% if b.warn != blank %}<div class="nani-doc__warn">{{ b.warn }}</div>{% endif %}

            {% when 'rates' %}
              {% if b.body != blank %}<div class="nani-doc__text">{{ b.body }}</div>{% endif %}
              <table class="nani-doc__rates">
                <thead>
                  <tr>
                    <th>{{ b.col_method | default: 'Method' }}</th>
                    <th>{{ b.col_delivery | default: 'Delivery' }}</th>
                    <th>{{ b.col_rate | default: 'Rate' }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% assign rows = b.rows | newline_to_br | split: '<br />' %}
                  {% for row in rows %}
                    {% if row != blank %}
                      {% assign cells = row | split: '|' %}
                      {% liquid
                        assign highlight = false
                        if cells[3] != blank
                          assign flag = cells[3] | strip | downcase
                          if flag == 'highlight' or flag == 'hl'
                            assign highlight = true
                          endif
                        endif
                      %}
                      <tr{% if highlight %} class="nani-doc__rates-hl"{% endif %}>
                        <td><b>{{ cells[0] | strip }}</b></td>
                        <td>{{ cells[1] | strip }}</td>
                        <td{% if cells[2] contains 'Free' or cells[2] contains 'free' %} class="nani-doc__rates-free"{% endif %}>{{ cells[2] | strip }}</td>
                      </tr>
                    {% endif %}
                  {% endfor %}
                </tbody>
              </table>
              {% if b.warn != blank %}<div class="nani-doc__warn">{{ b.warn }}</div>{% endif %}

            {% when 'steps' %}
              {% if b.body != blank %}<div class="nani-doc__text">{{ b.body }}</div>{% endif %}
              <div class="nani-doc__steps">
                {% assign steps = b.steps | newline_to_br | split: '<br />' %}
                {% for step in steps %}
                  {% if step != blank %}
                    {% assign sparts = step | split: '|' %}
                    <div class="nani-doc__step">
                      <div class="nani-doc__step-n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
                      <h4>{{ sparts[0] | strip }}</h4>
                      <p>{{ sparts[1] | strip }}</p>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              {% if b.sub_heading != blank %}
                <h4 class="nani-doc__sub-heading">{{ b.sub_heading }}</h4>
              {% endif %}
              {% if b.list != blank %}
                {% assign items = b.list | newline_to_br | split: '<br />' %}
                <ul class="nani-doc__list">
                  {% for item in items %}
                    {% if item != blank %}<li>{{ item | strip }}</li>{% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
              {% if b.warn != blank %}<div class="nani-doc__warn">{{ b.warn }}</div>{% endif %}

            {% when 'faq' %}
              {% if b.body != blank %}<div class="nani-doc__text">{{ b.body }}</div>{% endif %}
              <div class="nani-doc__faq">
                {% assign qs = b.qa_list | newline_to_br | split: '<br />' %}
                {% for q in qs %}
                  {% if q != blank %}
                    {% assign qaparts = q | split: '||' %}
                    {% if qaparts[0] != blank %}
                      <details class="nani-doc__faq-q"{% if forloop.first %} open{% endif %}>
                        <summary>{{ qaparts[0] | strip }}</summary>
                        <div class="nani-doc__faq-a">{{ qaparts[1] | strip }}</div>
                      </details>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>

            {% when 'callout' %}
              <div class="nani-doc__callout">
                <div>
                  <h3 class="nani-doc__callout-title">{{ b.callout_title | default: 'Still stuck?' }}</h3>
                  <p>{{ b.callout_copy | default: 'We read every DM and email. Usually replies within the hour.' }}</p>
                </div>
                <div class="nani-doc__callout-ctas">
                  {% if b.cta_1_label != blank %}
                    <a class="nani-doc__callout-cta nani-doc__callout-cta--gold" href="{{ b.cta_1_url | default: '#' }}">{{ b.cta_1_label }}</a>
                  {% endif %}
                  {% if b.cta_2_label != blank %}
                    <a class="nani-doc__callout-cta nani-doc__callout-cta--ghost" href="{{ b.cta_2_url | default: '#' }}">{{ b.cta_2_label }}</a>
                  {% endif %}
                </div>
              </div>

          {% endcase %}
        </section>
      {% endfor %}
    </main>
  </div>
</section>

<script>
(function(){
  const tocLinks = document.querySelectorAll('.nani-doc__toc-links a');
  const sections = document.querySelectorAll('.nani-doc__section');
  function onScroll(){
    const y = window.scrollY + 140;
    let cur = sections[0];
    sections.forEach(s => { if (s.offsetTop <= y) cur = s; });
    if (cur) tocLinks.forEach(l => l.classList.toggle('nani-doc__toc--on', l.getAttribute('href') === '#' + cur.id));
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  tocLinks.forEach(l => l.addEventListener('click', (e) => {
    e.preventDefault();
    const t = document.querySelector(l.getAttribute('href'));
    if (t) window.scrollTo({ top: t.offsetTop - 100, behavior: 'smooth' });
  }));
})();
</script>

{% stylesheet %}
  .nani-doc { position: relative; font-family: var(--font-body--family); }
  .nani-doc__crumb {
    max-width: 1440px;
    margin: 0 auto;
    padding: 20px 40px 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.7;
  }
  .nani-doc__crumb a { color: inherit; text-decoration: none; }
  .nani-doc__crumb a:hover { color: var(--color-primary); }
  .nani-doc__crumb .sep { margin: 0 8px; color: var(--color-primary); }
  .nani-doc__crumb .here { color: var(--color-foreground-heading); font-weight: 500; }

  .nani-doc__layout {
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--pbs) 40px var(--pbe) 40px;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 72px;
  }

  /* TOC */
  .nani-doc__toc {
    position: sticky;
    top: 100px;
    align-self: start;
    font-size: 13px;
  }
  .nani-doc__toc h5 {
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 16px;
    font-weight: 600;
  }
  .nani-doc__toc-links {
    display: flex;
    flex-direction: column;
  }
  .nani-doc__toc-links a {
    padding: 10px 14px;
    color: var(--color-foreground);
    border-left: 2px solid transparent;
    transition: all 0.15s ease;
    font-size: 13px;
    text-decoration: none;
  }
  .nani-doc__toc-links a:hover {
    color: var(--color-primary);
    border-color: rgb(var(--color-foreground-rgb) / 0.1);
  }
  .nani-doc__toc--on {
    color: var(--color-primary) !important;
    border-color: var(--color-primary) !important;
    background: var(--color-background-secondary, rgba(13,10,11,0.04));
    font-weight: 500;
  }
  .nani-doc__help {
    margin-top: 32px;
    padding: 22px;
    background: var(--color-primary);
    color: var(--color-background);
  }
  .nani-doc__help h6 {
    font-family: var(--font-heading--family);
    font-size: 22px;
    margin: 0 0 6px;
    font-weight: 500;
    color: #F0E3B8;
  }
  .nani-doc__help p {
    font-size: 12.5px;
    margin: 0 0 14px;
    color: rgba(253,246,240,0.8);
    line-height: 1.5;
  }
  .nani-doc__help a {
    color: #C9A227;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border-bottom: 1px solid #C9A227;
    padding-bottom: 3px;
    text-decoration: none;
    display: inline-block;
  }

  /* BODY */
  .nani-doc__body { min-width: 0; }
  .nani-doc__meta-eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 14px;
    font-weight: 500;
  }
  .nani-doc__title {
    font-family: var(--font-heading--family);
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    color: var(--color-foreground-heading);
  }
  .nani-doc__title em { font-style: italic; color: var(--color-primary); }
  .nani-doc__intro {
    color: var(--color-foreground);
    opacity: 0.88;
    font-size: 16px;
    max-width: 620px;
    margin: 0 0 40px;
    line-height: 1.65;
  }

  .nani-doc__tldr {
    background: var(--color-background-secondary, rgba(13,10,11,0.03));
    border-left: 3px solid var(--color-primary);
    padding: 24px 28px;
    margin: 0 0 56px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .nani-doc__tldr-l {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 4px;
    font-weight: 500;
    opacity: 0.85;
  }
  .nani-doc__tldr-v {
    font-family: var(--font-heading--family);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-foreground-heading);
  }
  .nani-doc__tldr-s {
    font-size: 12px;
    color: var(--color-foreground);
    opacity: 0.65;
    margin-top: 2px;
  }

  .nani-doc__section {
    padding: 44px 0;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }
  .nani-doc__section:first-of-type { border-top: 0; padding-top: 0; }
  .nani-doc__section-eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 10px;
    font-weight: 500;
  }
  .nani-doc__section-title {
    font-family: var(--font-heading--family);
    font-size: clamp(30px, 3.2vw, 42px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: var(--color-foreground-heading);
  }
  .nani-doc__section-title em { font-style: italic; color: var(--color-primary); }

  .nani-doc__text {
    font-size: 15px;
    color: var(--color-foreground);
    max-width: 720px;
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .nani-doc__text p { margin: 0 0 14px; }
  .nani-doc__text a { color: var(--color-primary); text-decoration: underline; }

  .nani-doc__list {
    padding-left: 0;
    list-style: none;
    max-width: 720px;
    margin: 16px 0;
  }
  .nani-doc__list li {
    position: relative;
    padding: 10px 0 10px 28px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.06);
    font-size: 14.5px;
    color: var(--color-foreground);
  }
  .nani-doc__list li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: #C9A227;
    font-size: 14px;
    top: 12px;
  }

  .nani-doc__sub-heading {
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 500;
    margin: 32px 0 10px;
    color: var(--color-foreground-heading);
  }

  /* RATE TABLE */
  .nani-doc__rates {
    width: 100%;
    max-width: 720px;
    border-collapse: collapse;
    margin: 20px 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }
  .nani-doc__rates th,
  .nani-doc__rates td {
    padding: 16px 20px;
    text-align: left;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    font-size: 14px;
  }
  .nani-doc__rates th {
    background: var(--color-background-secondary, rgba(13,10,11,0.03));
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-primary);
  }
  .nani-doc__rates td:last-child {
    text-align: right;
    font-family: var(--font-heading--family);
    font-size: 19px;
    color: var(--color-primary);
    font-weight: 500;
  }
  .nani-doc__rates tr:last-child td { border-bottom: 0; }
  .nani-doc__rates-hl td { background: rgba(201,162,39,0.08); }
  .nani-doc__rates-free { color: #C9A227 !important; }

  /* STEPS */
  .nani-doc__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 24px 0;
    max-width: 920px;
  }
  .nani-doc__step {
    padding: 22px;
    background: var(--color-background-secondary, rgba(13,10,11,0.03));
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    position: relative;
  }
  .nani-doc__step-n {
    font-family: var(--font-heading--family);
    font-size: 48px;
    color: var(--color-primary);
    font-weight: 500;
    line-height: 1;
    opacity: 0.25;
    position: absolute;
    top: 12px;
    right: 18px;
  }
  .nani-doc__step h4 {
    font-family: var(--font-heading--family);
    font-size: 22px;
    margin: 0 0 8px;
    font-weight: 500;
    color: var(--color-foreground-heading);
  }
  .nani-doc__step p {
    font-size: 13px;
    color: var(--color-foreground);
    opacity: 0.85;
    margin: 0;
    line-height: 1.55;
  }

  /* WARN */
  .nani-doc__warn {
    background: rgba(200,16,46,0.06);
    border-left: 3px solid var(--color-primary);
    padding: 18px 22px;
    margin: 18px 0;
    max-width: 720px;
    font-size: 13.5px;
    color: var(--color-foreground);
    line-height: 1.6;
  }
  .nani-doc__warn b { color: var(--color-primary); }

  /* FAQ */
  .nani-doc__faq {
    max-width: 820px;
    margin: 16px 0;
  }
  .nani-doc__faq-q {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }
  .nani-doc__faq-q summary {
    list-style: none;
    padding: 22px 0;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-foreground-heading);
  }
  .nani-doc__faq-q summary::-webkit-details-marker { display: none; }
  .nani-doc__faq-q summary::after {
    content: "+";
    font-size: 26px;
    color: var(--color-primary);
    font-weight: 300;
    transition: transform 0.2s ease;
    font-family: var(--font-body--family);
  }
  .nani-doc__faq-q[open] summary::after { content: "–"; }
  .nani-doc__faq-a {
    padding: 0 0 22px;
    font-size: 14.5px;
    color: var(--color-foreground);
    opacity: 0.9;
    line-height: 1.7;
    max-width: 720px;
  }
  .nani-doc__faq-a a { color: var(--color-primary); border-bottom: 1px solid var(--color-primary); text-decoration: none; }

  /* CALLOUT */
  .nani-doc__callout {
    background: var(--color-foreground-heading);
    color: var(--color-background);
    padding: 44px;
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    max-width: 920px;
    flex-wrap: wrap;
  }
  .nani-doc__callout-title {
    font-family: var(--font-heading--family);
    font-size: 30px;
    margin: 0 0 6px;
    font-weight: 500;
    color: var(--color-background);
  }
  .nani-doc__callout-title em { font-style: italic; color: #F0E3B8; }
  .nani-doc__callout p {
    color: rgba(253,246,240,0.8);
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .nani-doc__callout-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .nani-doc__callout-cta {
    padding: 12px 20px;
    font-family: var(--font-body--family);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.15s ease;
  }
  .nani-doc__callout-cta--gold { background: #C9A227; color: #0D0A0B; }
  .nani-doc__callout-cta--gold:hover { background: #F0E3B8; }
  .nani-doc__callout-cta--ghost {
    background: transparent;
    color: #FBF8F6;
    border: 1px solid #FBF8F6;
  }
  .nani-doc__callout-cta--ghost:hover { background: rgba(253,246,240,0.1); }

  @media screen and (max-width: 1100px) {
    .nani-doc__layout {
      grid-template-columns: 1fr;
      padding: var(--pbs) 24px var(--pbe) 24px;
      gap: 32px;
    }
    .nani-doc__toc { position: static; }
    .nani-doc__tldr { grid-template-columns: 1fr; gap: 16px; }
    .nani-doc__steps { grid-template-columns: 1fr 1fr; }
  }
  @media screen and (max-width: 749px) {
    .nani-doc__steps { grid-template-columns: 1fr; }
    .nani-doc__callout { flex-direction: column; align-items: flex-start; padding: 28px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shipping doc",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page", "index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_crumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "crumb_label",
      "label": "Breadcrumb last label",
      "default": "Shipping & Returns"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Meta eyebrow",
      "default": "Support · Last updated Apr 2026"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Shipping & <em>returns.</em>"
