{% liquid
  assign s = section.settings
%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section
  class="value-bar color-{{ s.color_scheme }}"
  style="--value-padding-block: {{ s.padding-block }}px;"
>
  <div class="value-bar__inner">
    {% for block in section.blocks %}
      {% liquid
        assign b = block.settings
      %}
      <div class="value-bar__item" {{ block.shopify_attributes }}>
        <span class="value-bar__icon" aria-hidden="true">
          {% case b.icon %}
            {% when 'shipping' %}
              <svg viewBox="0 0 24 24"><path d="M3 7h18l-2 10H5L3 7z"/><path d="M3 7l-1-3h2"/><circle cx="9" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg>
            {% when 'star' %}
              <svg viewBox="0 0 24 24"><path d="M12 2l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z"/></svg>
            {% when 'mail' %}
              <svg viewBox="0 0 24 24"><path d="M4 7h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>
            {% when 'check' %}
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
            {% when 'heart' %}
              <svg viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
            {% when 'leaf' %}
              <svg viewBox="0 0 24 24"><path d="M4 20s0-14 16-16c0 0-1 12-16 16z"/><path d="M4 20l8-8"/></svg>
            {% when 'gift' %}
              <svg viewBox="0 0 24 24"><path d="M3 10h18v10H3z"/><path d="M3 10h18"/><path d="M12 10V4"/><path d="M8 4a3 3 0 0 1 4 2 3 3 0 0 1 4-2"/></svg>
            {% when 'shield' %}
              <svg viewBox="0 0 24 24"><path d="M12 2l8 3v7c0 5-8 10-8 10s-8-5-8-10V5l8-3z"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/></svg>
          {% endcase %}
        </span>
        <div class="value-bar__text">
          <h4 class="value-bar__title">{{ b.title }}</h4>
          {% if b.description != blank %}
            <p class="value-bar__desc">{{ b.description }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .value-bar {
    position: relative;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .value-bar__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: 0 40px;
  }

  .value-bar__item {
    padding: var(--value-padding-block) 32px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
    border-right: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .value-bar__item:last-child {
    border-right: 0;
  }

  .value-bar__icon svg {
    width: 26px;
    height: 26px;
    stroke: var(--color-primary);
    fill: none;
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
    flex-shrink: 0;
    margin-top: 2px;
    display: block;
  }

  .value-bar__title {
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 500;
    margin: 0 0 6px;
    color: var(--color-foreground-heading);
    line-height: 1.1;
  }

  .value-bar__desc {
    font-family: var(--font-body--family);
    font-size: 13px;
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 1100px) {
    .value-bar__inner {
      grid-template-columns: repeat(2, 1fr);
      padding: 0 24px;
    }
    .value-bar__item:nth-child(2) {
      border-right: 0;
    }
    .value-bar__item:nth-child(1),
    .value-bar__item:nth-child(2) {
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    }
  }

  @media screen and (max-width: 560px) {
    .value-bar__inner {
      grid-template-columns: 1fr;
    }
    .value-bar__item {
      border-right: 0;
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
      padding: 28px 16px;
    }
    .value-bar__item:last-child {
      border-bottom: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Value bar",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding-block",
      "label": "Vertical padding",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "star", "label": "Star" },
            { "value": "mail", "label": "Mail" },
            { "value": "check", "label": "Check" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "gift", "label": "Gift" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping $50+"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Ships in 1–2 days from Akron, OH. Delivered in 3–5 days nationwide."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Value bar",
      "category": "Redkisses",
      "blocks": [
        { "type": "value", "settings": { "icon": "shipping", "title": "Free shipping $50+", "description": "Ships in 1–2 days from Akron, OH. Delivered in 3–5 days nationwide." } },
        { "type": "value", "settings": { "icon": "star", "title": "Rated 4.9 by 300+", "description": "Over 300 five-star reviews from customers across the country." } },
        { "type": "value", "settings": { "icon": "mail", "title": "Real customer service", "description": "Text or DM @redkisses — you'll get a real person, not a bot." } },
        { "type": "value", "settings": { "icon": "check", "title": "30-day easy returns", "description": "Changed your mind? No problem. Unused items returnable within 30 days." } }
      ]
    }
  ]
}
{% endschema %}
